#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 50
#define FOOD_COUNT 5
#define MAX_ITEMS 10

// Circular Queue for active orders
int queue[MAX], front = -1, rear = -1;
int queueItems[MAX][MAX_ITEMS];  // store food indices per order
int queueItemCount[MAX];         // number of items in each order

// Stack for order history
int history[MAX], top = -1;
int historyItems[MAX][MAX_ITEMS];
int historyItemCount[MAX];

// Food Menu
char foodItems[FOOD_COUNT][20] = {"Pizza", "Burger", "Pasta", "Sandwich", "Fries"};

int orderCounter = 100;

// ----------- Queue Functions -----------
int isQueueFull() {
    return front == (rear + 1) % MAX;
}

int isQueueEmpty() {
    return front == -1;
}

void enqueue(int order, int items[], int count) {
    if (isQueueFull()) {
        printf("\n⚠️ Queue is Full! Cannot place more orders.\n");
        return;
    }

    if (isQueueEmpty()) front = 0;

    rear = (rear + 1) % MAX;
    queue[rear] = order;
    queueItemCount[rear] = count;

    for (int i = 0; i < count; i++) queueItems[rear][i] = items[i];

    printf("✅ Order %d placed successfully with %d item(s).\n", order, count);
}

int dequeue() {
    if (isQueueEmpty()) return -1;

    int order = queue[front];
    if (front == rear) front = rear = -1;
    else front = (front + 1) % MAX;

    return order;
}

int* dequeueItems(int* count) {
    if (isQueueEmpty()) {
        *count = 0;
        return NULL;
    }

    *count = queueItemCount[front];
    return queueItems[front];
}

void displayQueue() {
    if (isQueueEmpty()) {
        printf("\n📋 No pending orders in Queue.\n");
        return;
    }

    printf("\n📋 Pending Orders in Queue:\n");
    int i = front;
    while (1) {
        printf("Order %d - ", queue[i]);
        for (int j = 0; j < queueItemCount[i]; j++) {
            printf("%s", foodItems[queueItems[i][j]]);
            if (j < queueItemCount[i] - 1) printf(", ");
        }
        printf("\n");
        if (i == rear) break;
        i = (i + 1) % MAX;
    }
}

// ----------- Stack Functions -----------
void pushHistory(int order, int items[], int count) {
    if (top == MAX - 1) {
        printf("\n⚠️ History is Full!\n");
        return;
    }

    history[++top] = order;
    historyItemCount[top] = count;
    for (int i = 0; i < count; i++) historyItems[top][i] = items[i];
}

void displayHistory() {
    if (top == -1) {
        printf("\n📜 No previous orders in history.\n");
        return;
    }

    printf("\n📜 Order History (Latest First):\n");
    for (int i = top; i >= 0; i--) {
        printf("Order %d - ", history[i]);
        for (int j = 0; j < historyItemCount[i]; j++) {
            printf("%s", foodItems[historyItems[i][j]]);
            if (j < historyItemCount[i] - 1) printf(", ");
        }
        printf("\n");
    }
}

// ----------- Food Menu -----------
